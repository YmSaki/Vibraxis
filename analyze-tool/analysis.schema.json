{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibraxis.local/schemas/analysis-v2.json",
  "title": "Vibraxis audio analysis v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "trackId", "source", "analyzer", "capabilities", "tempo", "tonal", "harmony", "structure", "features", "overridesApplied"],
  "properties": {
    "schemaVersion": {"const": 2},
    "trackId": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "sha256", "durationSeconds", "sampleRate"],
      "properties": {
        "file": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "durationSeconds": {"type": "number", "exclusiveMinimum": 0},
        "sampleRate": {"type": "integer", "minimum": 1}
      }
    },
    "analyzer": {"$ref": "#/$defs/analyzer"},
    "capabilities": {
      "type": "object",
      "required": ["features", "beatGrid", "harmony", "structure"],
      "additionalProperties": {"$ref": "#/$defs/capability"}
    },
    "tempo": {
      "type": "object",
      "required": ["bpm", "rawBpm", "adjustment", "timeSignature", "beatsSeconds", "downbeatsSeconds", "barsSeconds"],
      "properties": {
        "bpm": {"type": "number", "exclusiveMinimum": 0},
        "rawBpm": {"type": "number", "exclusiveMinimum": 0},
        "timeSignature": {"type": "string"},
        "beatsSeconds": {"type": "array", "items": {"type": "number", "minimum": 0}},
        "downbeatsSeconds": {"type": "array", "items": {"type": "number", "minimum": 0}},
        "barsSeconds": {"type": "array", "items": {"type": "number", "minimum": 0}}
      }
    },
    "tonal": {
      "type": "object",
      "required": ["key", "scale", "camelot", "confidence", "keyRegions"],
      "properties": {"keyRegions": {"type": "array", "items": {"$ref": "#/$defs/keyRegion"}}}
    },
    "harmony": {
      "type": "object",
      "required": ["chords"],
      "properties": {"chords": {"type": "array", "items": {"$ref": "#/$defs/chord"}}}
    },
    "structure": {
      "type": "object",
      "required": ["sections", "phrases"],
      "properties": {
        "sections": {"type": "array", "items": {"$ref": "#/$defs/section"}},
        "phrases": {"type": "array", "items": {"$ref": "#/$defs/phrase"}}
      }
    },
    "features": {"$ref": "#/$defs/features"},
    "overridesApplied": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "analyzer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "version", "analyzedAt", "configHash"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "analyzedAt": {"type": "string", "minLength": 1},
        "configHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": ["energy", "rms", "loudnessDb", "dynamicRangeDb", "onsetRate", "spectralCentroidHz"],
      "properties": {
        "energy": {"type": "number", "minimum": 0, "maximum": 1},
        "rms": {"type": "number", "minimum": 0},
        "loudnessDb": {"type": "number"},
        "dynamicRangeDb": {"type": "number", "minimum": 0},
        "onsetRate": {"type": "number", "minimum": 0},
        "spectralCentroidHz": {"type": "number", "minimum": 0}
      }
    },
    "capability": {
      "type": "object",
      "required": ["status", "provider", "version", "confidence", "error"],
      "additionalProperties": false,
      "properties": {
        "status": {"enum": ["complete", "partial", "failed", "skipped"]},
        "provider": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "error": {"type": ["string", "null"]}
      }
    },
    "keyRegion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startSeconds", "endSeconds", "key", "scale", "confidence"],
      "properties": {
        "startSeconds": {"type": "number", "minimum": 0},
        "endSeconds": {"type": "number", "exclusiveMinimum": 0},
        "key": {"type": "string", "minLength": 1},
        "scale": {"enum": ["major", "minor"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "chord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rawStartSeconds", "rawEndSeconds", "startSeconds", "endSeconds", "beatIndex", "barIndex", "symbol", "root", "quality", "bass", "localKey", "degree", "confidence"],
      "properties": {
        "rawStartSeconds": {"type": "number", "minimum": 0},
        "rawEndSeconds": {"type": "number", "exclusiveMinimum": 0},
        "startSeconds": {"type": "number", "minimum": 0},
        "endSeconds": {"type": "number", "exclusiveMinimum": 0},
        "beatIndex": {"type": "integer", "minimum": 0},
        "barIndex": {"type": "integer", "minimum": 0},
        "symbol": {"type": "string", "minLength": 1},
        "root": {"type": ["string", "null"]},
        "quality": {"type": "string", "minLength": 1},
        "bass": {"type": ["string", "null"]},
        "localKey": {"type": "string", "minLength": 1},
        "degree": {"type": "string", "minLength": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startSeconds", "endSeconds", "startBeat", "endBeat", "startBar", "endBar", "label", "rawLabel", "confidence", "energy"],
      "properties": {
        "startSeconds": {"type": "number", "minimum": 0},
        "endSeconds": {"type": "number", "exclusiveMinimum": 0},
        "startBeat": {"type": "integer", "minimum": 0},
        "endBeat": {"type": "integer", "minimum": 0},
        "startBar": {"type": "integer", "minimum": 0},
        "endBar": {"type": "integer", "minimum": 0},
        "label": {"enum": ["intro", "verse", "preChorus", "chorus", "build", "drop", "breakdown", "bridge", "instrumental", "outro", "other"]},
        "rawLabel": {"type": "string"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "energy": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "phrase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startSeconds", "endSeconds", "startBar", "endBar", "sectionIndex"],
      "properties": {
        "startSeconds": {"type": "number", "minimum": 0},
        "endSeconds": {"type": "number", "exclusiveMinimum": 0},
        "startBar": {"type": "integer", "minimum": 0},
        "endBar": {"type": "integer", "minimum": 1},
        "sectionIndex": {"type": "integer", "minimum": 0}
      }
    }
  }
}
