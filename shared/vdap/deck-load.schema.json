{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibraxis.local/schemas/vdap/deck-load.schema.json",
  "title": "VDAP P0 catalog deck.load request",
  "type": "object",
  "additionalProperties": false,
  "required": ["vdap", "kind", "requestId", "command", "params"],
  "properties": {
    "vdap": {"const": "1.0"},
    "kind": {"const": "request"},
    "requestId": {"type": "string", "minLength": 1},
    "command": {"const": "deck.load"},
    "expectedRevision": {"type": "integer", "minimum": 1},
    "expectedBindingId": {"type": "string", "minLength": 1},
    "when": {
      "type": "object",
      "additionalProperties": false,
      "required": ["at"],
      "properties": {"at": {"const": "immediate"}}
    },
    "params": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deckId", "source"],
      "properties": {
        "deckId": {"enum": ["A", "B"]},
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "trackId"],
          "properties": {
            "kind": {"const": "catalog"},
            "trackId": {"type": "string", "minLength": 1}
          }
        },
        "requireAnalysis": {"type": "boolean"},
        "initialPosition": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sourceSeconds"],
          "properties": {
            "sourceSeconds": {"type": "number", "minimum": 0}
          }
        },
        "replacePlaying": {"type": "boolean"}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "required": ["params"],
        "properties": {
          "params": {
            "type": "object",
            "required": ["replacePlaying"],
            "properties": {"replacePlaying": {"const": true}}
          }
        }
      },
      "then": {
        "type": "object",
        "required": ["expectedBindingId"],
        "properties": {"expectedBindingId": true}
      }
    }
  ]
}
