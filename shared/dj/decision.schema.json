{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibraxis.local/schemas/dj/decision.schema.json",
  "title": "Vibraxis DJ Decision",
  "description": "A high-level track and transition choice. Runtime commands and media locations are intentionally excluded.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "nextTrackId",
    "targetDeckId",
    "tempoSync",
    "startAt",
    "crossfadeBars",
    "confidence",
    "reasons"
  ],
  "properties": {
    "nextTrackId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "targetDeckId": {
      "type": "string",
      "enum": ["A", "B"]
    },
    "tempoSync": {
      "type": "string",
      "enum": ["none", "tempo"]
    },
    "startAt": {
      "type": "string",
      "enum": ["nextBar"]
    },
    "crossfadeBars": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "reasons": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "type": "string", "minLength": 1, "maxLength": 300 }
    }
  }
}
