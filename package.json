{
  "name": "vibraxis",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["frontend", "backend", "shared"],
  "scripts": {
    "start": "npm --workspace frontend run dev -- --host 0.0.0.0",
    "build": "npm --workspace frontend run build",
    "test": "npm --workspace frontend run test",
    "test:contracts": "node --test shared/contracts/schemas.test.mjs",
    "check:protocol-docs": "node scripts/check-protocol-docs.mjs",
    "check": "npm run check:protocol-docs && npm run test:contracts && npm --workspace shared run check && npm --workspace frontend run check"
  },
  "devDependencies": {
    "ajv": "^8.17.1"
  }
}
